<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_codesamplelang</name>
    <author>Michael Speckenbach</author>
    <authorEmail>software@speckenbach.net</authorEmail>
    <authorUrl>https://software.speckenbach.net</authorUrl>
    <creationDate>2026-11-13</creationDate>
    <license>GNU General Public License version 2 or later</license>
    <version>1.3.0</version>
    <description>PLG_SYSTEM_CODESAMPLELANG_XML_DESCRIPTION</description>

    <namespace path="src">SpeckenbachNet\Plugin\System\CodeSampleLang</namespace>

    <files>
        <folder plugin="codesamplelang">services</folder>
        <folder>src</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_codesamplelang.ini</language>
        <language tag="en-GB">en-GB/plg_system_codesamplelang.sys.ini</language>
        <language tag="de-DE">de-DE/plg_system_codesamplelang.ini</language>
        <language tag="de-DE">de-DE/plg_system_codesamplelang.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="note_help"
                    type="note"
                    class="alert alert-info"
                    description="PLG_SYSTEM_CODESAMPLELANG_FIELD_NOTE_HELP_DESC"
                />
                <!-- Default = TinyMCE's built-in list, so a fresh install shows what the dropdown contains -->
                <field
                    name="languages"
                    type="subform"
                    label="PLG_SYSTEM_CODESAMPLELANG_FIELD_LANGUAGES_LABEL"
                    description="PLG_SYSTEM_CODESAMPLELANG_FIELD_LANGUAGES_DESC"
                    multiple="true"
                    layout="joomla.form.field.subform.repeatable-table"
                    buttons="add,remove,move"
                    default='{"languages0":{"text":"HTML/XML","value":"markup"},"languages1":{"text":"JavaScript","value":"javascript"},"languages2":{"text":"CSS","value":"css"},"languages3":{"text":"PHP","value":"php"},"languages4":{"text":"Ruby","value":"ruby"},"languages5":{"text":"Python","value":"python"},"languages6":{"text":"Java","value":"java"},"languages7":{"text":"C","value":"c"},"languages8":{"text":"C#","value":"csharp"},"languages9":{"text":"C++","value":"cpp"}}'
                >
                    <form hidden="true">
                        <field
                            name="text"
                            type="text"
                            label="PLG_SYSTEM_CODESAMPLELANG_FIELD_TEXT_LABEL"
                            hint="PLG_SYSTEM_CODESAMPLELANG_FIELD_TEXT_HINT"
                            required="true"
                        />
                        <field
                            name="value"
                            type="text"
                            label="PLG_SYSTEM_CODESAMPLELANG_FIELD_VALUE_LABEL"
                            hint="PLG_SYSTEM_CODESAMPLELANG_FIELD_VALUE_HINT"
                            required="true"
                        />
                    </form>
                </field>
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="CodeSampleLangM">https://github.com/SpeckenbachNet/CodeSampleLangM/releases/latest/download/updates.xml</server>
    </updateservers>
</extension>
